ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
# Your Neon branch connection string (Psycopg 3):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
# Keep your existing Neon DATABASE_URL in server/.env.
# Paystack test secret key (backend only). Live keys are rejected by V1.
PAYSTACK_SECRET_KEY=
# Browser return URL; use the same hostname as your frontend login session.
PAYSTACK_CALLBACK_URL=http://localhost:5173/buyer/payments
# Optional for the modern Paystack-Signature webhook scheme (whsec_...).
# Legacy x-paystack-signature uses PAYSTACK_SECRET_KEY instead.
PAYSTACK_WEBHOOK_SECRET=
# Dashboard test webhook URL: https://YOUR-PUBLIC-API/api/payments/paystack/webhook

# V1 background worker: run flask --app run.py v1-worker as a separate process.
WORKER_INTERVAL_SECONDS=30
NOTIFICATION_EMAILS_ENABLED=true
PUBLIC_FRONTEND_URL=http://localhost:5173

# Topics 1–4 media uploads. Set in server/.env; never in VITE_* variables.
# Optional: only needed for files previously stored in Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
