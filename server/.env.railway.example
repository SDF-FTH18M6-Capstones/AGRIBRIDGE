# API and worker: set these through Railway Variables; never commit real values.
ENVIRONMENT=production
PORT=8080
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
PUBLIC_FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN
PASSWORD_RESET_URL=https://YOUR-FRONTEND-DOMAIN/reset-password
PAYSTACK_CALLBACK_URL=https://YOUR-FRONTEND-DOMAIN/buyer/payments
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN
# Use your Paystack TEST key. The application intentionally rejects live keys.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
WORKER_INTERVAL_SECONDS=30
# Enable after SMTP delivery has been configured and tested.
NOTIFICATION_EMAILS_ENABLED=false
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Optional, only for previously uploaded Cloudinary assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
