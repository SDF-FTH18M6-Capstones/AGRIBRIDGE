# Railway frontend service runtime variables. No database or payment credentials.
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=https://YOUR-FRONTEND-DOMAIN
# Begin with the API's public HTTPS domain; private networking is optional later.
SSR_API_URL=https://YOUR-API-DOMAIN/api
# The Docker build fixes browser API calls to the same-origin proxy.
VITE_API_BASE_URL=/api
